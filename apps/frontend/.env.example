# Leave empty in local dev so Vite proxies /api (avoids CORS + 127.0.0.1:3001 conflicts).
VITE_API_BASE_URL=

# Leave empty to use the page origin; Vite proxies /socket.io to Nest.
VITE_SOCKET_URL=

# Optional: force Vite proxy target if auto-detected LAN IP is wrong
# VITE_PROXY_TARGET=http://192.168.x.x:3001
